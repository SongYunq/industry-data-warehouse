# Copy to .env and adjust values for this machine. Never commit real credentials.

# H&M Kaggle files are stored locally; authenticate Kaggle CLI in the user profile.
# Do not put Kaggle API tokens in this project file.
HM_MANIFEST=docs/附件-数据下载校验清单.csv

# Runtime metadata and logs
MANIFEST_DIR=data/manifests
LOG_DIR=logs

# Apache Doris service connection
DORIS_HOST=127.0.0.1
DORIS_QUERY_PORT=9030
DORIS_FE_HTTP_PORT=8030
DORIS_BE_HTTP_PORT=8040
DORIS_USER=root
DORIS_PASSWORD=
# Local Doris FE Java heap maximum in MiB.
DORIS_FE_HEAP_MB=2048
# Doris BE storage page cache limit as a percentage.
DORIS_BE_PAGE_CACHE_PERCENT=5

# Browser service ports (bound to localhost by Compose)
STREAMLIT_HOST=127.0.0.1
STREAMLIT_PORT=8501
METABASE_HOST=127.0.0.1
METABASE_PORT=3000
METABASE_JAVA_OPTS="-Xms256m -Xmx1024m"

# Dedicated Doris credential for the H&M Metabase data source.
HM_METABASE_DORIS_PASSWORD=
# Administrator API key for publishing the local H&M Metabase dashboard.
METABASE_API_KEY=

# PostgreSQL application database used by Metabase
MB_DB_TYPE=postgres
MB_DB_HOST=postgres
MB_DB_PORT=5432
MB_DB_DBNAME=metabase_app
MB_DB_USER=metabase
MB_DB_PASS=
