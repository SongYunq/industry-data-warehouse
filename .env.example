# ==============================================================================
# Industry Data Warehouse 本地运行环境配置模板 (.env.example)
# 复制为 .env 后按本机环境调整；真实密码或敏感配置请勿提交至 Git
# ==============================================================================

# 1. Inside Airbnb 文件清单与下载超时
INSIDE_AIRBNB_MANIFEST=docs_v2/附件-数据下载校验清单.csv
INSIDE_AIRBNB_TIMEOUT=90

# 2. 既有服务管理入口使用的目录配置；V2 数据命令按清单落到 data_v2/raw/inside_airbnb/
DATA_DIR=data/raw
MANIFEST_DIR=data/manifests
STAGING_DIR=data/staging
LOG_DIR=logs

# 3. Apache Doris 服务连接配置（数据模型与库表在 W04—W07 后确定）
DORIS_HOST=127.0.0.1
DORIS_QUERY_PORT=9030
DORIS_FE_HTTP_PORT=8030
DORIS_BE_HTTP_PORT=8040
DORIS_USER=root
DORIS_PASSWORD=
DORIS_LOAD_URL=http://127.0.0.1:8040
DORIS_LOAD_TIMEOUT=120

# 4. 浏览器端服务监听端口（默认仅绑定本机 127.0.0.1）
STREAMLIT_HOST=127.0.0.1
STREAMLIT_PORT=8501
METABASE_HOST=127.0.0.1
METABASE_PORT=3000

# 5. Metabase 自身应用配置数据库与本地管理员账户（容器内部网络访问独立 PostgreSQL）
# 请在复制为 .env 后填入本机密码与管理员邮箱（密码需包含大小写字母、数字与符号且不少于 8 位）
MB_DB_TYPE=postgres
MB_DB_HOST=postgres
MB_DB_PORT=5432
MB_DB_DBNAME=metabase_app
MB_DB_USER=metabase
MB_DB_PASS=
MB_ADMIN_EMAIL=
MB_ADMIN_PASS=
