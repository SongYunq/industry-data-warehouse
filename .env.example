# Copy to .env and adjust values for this machine. Never commit real credentials.

# Inside Airbnb source manifest and request timeout
INSIDE_AIRBNB_MANIFEST=docs/附件-数据下载校验清单.csv
INSIDE_AIRBNB_TIMEOUT=90

# Runtime metadata and logs
MANIFEST_DIR=data/manifests
LOG_DIR=logs

# Apache Doris service connection
DORIS_HOST=127.0.0.1
DORIS_QUERY_PORT=9030
DORIS_FE_HTTP_PORT=8030
DORIS_BE_HTTP_PORT=8040
DORIS_USER=root
DORIS_PASSWORD=

# Browser service ports (bound to localhost by Compose)
STREAMLIT_HOST=127.0.0.1
STREAMLIT_PORT=8501
METABASE_HOST=127.0.0.1
METABASE_PORT=3000

# PostgreSQL application database used by Metabase
MB_DB_TYPE=postgres
MB_DB_HOST=postgres
MB_DB_PORT=5432
MB_DB_DBNAME=metabase_app
MB_DB_USER=metabase
MB_DB_PASS=
