# ==============================================================================
# Industry Data Warehouse 本地运行环境配置模板 (.env.example)
# 复制为 .env 后按本机环境调整；真实密码或敏感配置请勿提交至 Git
# ==============================================================================

# 1. 本地目录配置（支持相对项目根目录路径或绝对路径）
DATA_DIR=data/raw
MANIFEST_DIR=data/manifests
STAGING_DIR=data/staging
LOG_DIR=logs

# 2. 默认原始数据源配置（吉林派件完整原始文件）
LADE_SOURCE_URL=https://huggingface.co/datasets/Cainiao-AI/LaDe/resolve/main/delivery/delivery_jl.csv
LADE_DEFAULT_FILE=delivery/delivery_jl.csv

# 3. Apache Doris 连接与导入配置（宿主机访问回环地址）
DORIS_HOST=127.0.0.1
DORIS_QUERY_PORT=9030
DORIS_FE_HTTP_PORT=8030
DORIS_BE_HTTP_PORT=8040
DORIS_DATABASE=raw_lade
DORIS_TABLE=delivery_jl
DORIS_USER=root
DORIS_PASSWORD=
DORIS_LOAD_URL=http://127.0.0.1:8040
DORIS_LOAD_TIMEOUT=120

# 4. 浏览器端服务监听端口（默认仅绑定本机 127.0.0.1）
STREAMLIT_HOST=127.0.0.1
STREAMLIT_PORT=8501
METABASE_HOST=127.0.0.1
METABASE_PORT=3000

# 5. Metabase 自身应用配置数据库（容器内部网络访问独立 PostgreSQL）
MB_DB_TYPE=postgres
MB_DB_HOST=postgres
MB_DB_PORT=5432
MB_DB_DBNAME=metabase_app
MB_DB_USER=metabase
MB_DB_PASS=metabase_local_dev_pwd
