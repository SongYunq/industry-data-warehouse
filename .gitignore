.DS_Store
.pixi/
.env
__pycache__/
*.py[cod]
*$py.class
.streamlit/secrets.toml

# Local source data, runtime manifests, staging files, and logs
data/raw/*
!data/raw/.gitkeep
data/manifests/*
!data/manifests/.gitkeep
data/staging/*
!data/staging/.gitkeep
logs/*
!logs/.gitkeep

# External Doris driver binary; keep its checksum metadata
deploy/plugins/*.jar
